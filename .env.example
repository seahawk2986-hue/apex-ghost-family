# Apex cloud burst lanes - env template
# Copy to .env in the SAME folder as this file and fill in keys you choose.
# Every lane is fail-closed: missing key = lane skipped, local brain stays primary.
# NEVER commit .env anywhere. All these tiers are free at the time of wiring.

# --- already wired ---
GROQ_API_KEY=            # console.groq.com -> API Keys (free tier)
OPENROUTER_API_KEY=      # openrouter.ai/keys (free tier, :free models)
GEMINI_API_KEY=          # aistudio.google.com -> Get API key (free tier)

# --- new lanes 2026-10-31 ---
CEREBRAS_API_KEY=        # cloud.cerebras.ai -> API Keys (free tier, very fast)
HF_TOKEN=                # hf.co/settings/tokens (free accounts get Inference Providers credit)
GITHUB_MODELS_TOKEN=     # github.com/settings/personal-access-tokens -> enable Models (free w/ GitHub)

# --- optional model overrides ---
# CEREBRAS_MODEL=llama-3.3-70b
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# GITHUB_MODEL=openai/gpt-4o-mini